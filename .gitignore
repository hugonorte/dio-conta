# Arquivos compilados do Java
*.class

# Diretórios de build e saída (VS Code e compilação manual)
bin/
out/

# Logs e relatórios de crash da JVM
*.log
hs_err_pid*
replay_pid*

# Pacotes compactados / binários
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Caso queira ignorar jars gerados, mas manter bibliotecas locais em lib/
*.jar
!lib/*.jar

# Arquivos de configuração de IDEs
# Visual Studio Code
.vscode/*
!.vscode/settings.json
.history/
*.code-workspace

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr

# Eclipse
.project
.classpath
.settings/

# NetBeans
nbproject/private/
build/
nbbuild/
dist/
nbdist/

# Sistema Operacional
.DS_Store
Thumbs.db
Desktop.ini
